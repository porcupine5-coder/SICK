# SICK environment variables.
#
# Copy to `.env` (or export these in your shell) and fill in the keys you have.
# Numbered variants are supported for key rotation:
#   OPENAI_API_KEY_1, OPENAI_API_KEY_2, ...
# SICK_<PROVIDER>_API_KEY (and the legacy SHELL_AGENT_<PROVIDER>_API_KEY)
# variants are also recognized.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini (OpenAI-compatible endpoint). Either variable works:
GOOGLE_API_KEY=
GEMINI_API_KEY=

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=

# Override the state directory (default: ~/.sick; the legacy ~/.shell-agent
# directory keeps working when ~/.sick does not exist).
# SICK_HOME=
